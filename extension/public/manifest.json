{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Tabstow",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["tabs", "storage", "unlimitedStorage", "contextMenus", "alarms", "identity", "favicon"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "archive-window": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "__MSG_cmdArchiveWindow__"
    }
  }
}
